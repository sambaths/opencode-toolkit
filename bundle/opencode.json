{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "manager",
  "websearch": {
    "provider": "random"
  },
  "instructions": [
    ".opencode/instructions/INSTRUCTIONS.md"
  ],
  "experimental": {
    "subagent_depth": 1
  },
  "agents": {
    "build": {
      "description": "Primary coding agent for direct development work",
      "mode": "primary"
    },
    "code-reviewer": {
      "description": "Legacy ECC code reviewer; prefer reviewer for the coordinated workflow",
      "mode": "subagent",
      "system": "{file:prompts/agents/code-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "security-reviewer": {
      "description": "Security vulnerability analysis and assigned remediation",
      "mode": "subagent",
      "system": "{file:prompts/agents/security-reviewer.txt}"
    },
    "tdd-guide": {
      "description": "Project-adaptive test-first implementation",
      "mode": "subagent",
      "system": "{file:prompts/agents/tdd-guide.txt}"
    },
    "build-error-resolver": {
      "description": "Minimal TypeScript and build fixes",
      "mode": "subagent",
      "system": "{file:prompts/agents/build-error-resolver.txt}"
    },
    "e2e-runner": {
      "description": "Playwright end-to-end testing",
      "mode": "subagent",
      "system": "{file:prompts/agents/e2e-runner.txt}"
    },
    "doc-updater": {
      "description": "Documentation and codemap updates",
      "mode": "subagent",
      "system": "{file:prompts/agents/doc-updater.txt}"
    },
    "refactor-cleaner": {
      "description": "Explicitly assigned dead-code cleanup",
      "mode": "subagent",
      "system": "{file:prompts/agents/refactor-cleaner.txt}"
    },
    "go-reviewer": {
      "description": "Go code review",
      "mode": "subagent",
      "system": "{file:prompts/agents/go-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "go-build-resolver": {
      "description": "Minimal Go build fixes",
      "mode": "subagent",
      "system": "{file:prompts/agents/go-build-resolver.txt}"
    },
    "database-reviewer": {
      "description": "PostgreSQL query, schema, and security review",
      "mode": "subagent",
      "system": "{file:prompts/agents/database-reviewer.txt}"
    },
    "cpp-reviewer": {
      "description": "C++ code review",
      "mode": "subagent",
      "system": "{file:prompts/agents/cpp-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "cpp-build-resolver": {
      "description": "Minimal C++ build fixes",
      "mode": "subagent",
      "system": "{file:prompts/agents/cpp-build-resolver.txt}"
    },
    "docs-lookup": {
      "description": "Library documentation lookup when Context7 is available",
      "mode": "subagent",
      "system": "{file:prompts/agents/docs-lookup.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "harness-optimizer": {
      "description": "Assigned harness reliability and cost improvements",
      "mode": "subagent",
      "system": "{file:prompts/agents/harness-optimizer.txt}"
    },
    "java-reviewer": {
      "description": "Java and Spring code review",
      "mode": "subagent",
      "system": "{file:prompts/agents/java-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "java-build-resolver": {
      "description": "Minimal Java build fixes",
      "mode": "subagent",
      "system": "{file:prompts/agents/java-build-resolver.txt}"
    },
    "kotlin-reviewer": {
      "description": "Kotlin and Android code review",
      "mode": "subagent",
      "system": "{file:prompts/agents/kotlin-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "kotlin-build-resolver": {
      "description": "Minimal Kotlin build fixes",
      "mode": "subagent",
      "system": "{file:prompts/agents/kotlin-build-resolver.txt}"
    },
    "loop-operator": {
      "description": "Explicitly authorized autonomous-loop operation",
      "mode": "subagent",
      "system": "{file:prompts/agents/loop-operator.txt}"
    },
    "php-reviewer": {
      "description": "PHP code review",
      "mode": "subagent",
      "system": "{file:prompts/agents/php-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "python-reviewer": {
      "description": "Python code review",
      "mode": "subagent",
      "system": "{file:prompts/agents/python-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "rust-reviewer": {
      "description": "Rust code review",
      "mode": "subagent",
      "system": "{file:prompts/agents/rust-reviewer.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "rust-build-resolver": {
      "description": "Minimal Rust build fixes",
      "mode": "subagent",
      "system": "{file:prompts/agents/rust-build-resolver.txt}"
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git restore *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git branch -D *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh issue list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh issue view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr checks *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh repo view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh search *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh auth status *",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*envkeys",
      "effect": "deny"
    },
    {
      "action": "hermes_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
